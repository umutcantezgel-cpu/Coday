# ==================================
# Coday — Environment Variables
# Domain: www.codayweb.de
# Stack: Next.js 15, Supabase, Resend
# ==================================

# SUPABASE (Required)
# Get from: https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_URL_HERE
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE

# RESEND (Required for email notifications on lead/booking submissions)
# Get from: https://resend.com/api-keys
RESEND_API_KEY=YOUR_RESEND_API_KEY_HERE

# CRON SECRET (Required for /api/health keep-alive endpoint)
# Generate a random string, e.g.: openssl rand -hex 32
CRON_SECRET=YOUR_CRON_SECRET_HERE

# CLOUDFLARE TURNSTILE (Optional — anti-bot for LeadForm)
# Get from: https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=YOUR_TURNSTILE_SITE_KEY_HERE
TURNSTILE_SECRET_KEY=YOUR_TURNSTILE_SECRET_KEY_HERE

# GOOGLE MAPS (Optional — for interactive maps on contact page)
# Get from: https://console.cloud.google.com/apis/credentials
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# GEMINI API KEYS (Required for Website Analyzer AI and Chatbot — use comma-separated list for key pooling)
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEYS=YOUR_GEMINI_API_KEY_1,YOUR_GEMINI_API_KEY_2

# OPENROUTER API KEYS (Required for enhanced AI models — use comma-separated list for key pooling)
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEYS=YOUR_OPENROUTER_API_KEY_1,YOUR_OPENROUTER_API_KEY_2

# SLACK (Optional — webhook for hot lead alerts, score >= 7)
# Get from: https://api.slack.com/apps → Incoming Webhooks
SLACK_WEBHOOK_URL=YOUR_SLACK_WEBHOOK_URL_HERE

# SENTRY (Optional — error monitoring)
# Get from: https://sentry.io/settings/projects/ → Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=YOUR_SENTRY_DSN_HERE

# GOOGLE ANALYTICS (Optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=YOUR_GA_MEASUREMENT_ID_HERE
