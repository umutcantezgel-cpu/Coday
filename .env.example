# ==================================
# Agency Domination - Environment Variables
# Domain: www.codayweb.de
# ==================================
#
# ⚠️  SECURITY WARNING — KEY ROTATION REQUIRED
# The following keys were previously committed to git history and are
# considered COMPROMISED. You MUST generate fresh credentials:
#   - VITE_SUPABASE_ANON_KEY (Supabase Dashboard → Project Settings → API)
#   - RESEND_API_KEY          (Resend Dashboard → API Keys → Regenerate)
#   - VITE_GOOGLE_MAPS_API_KEY (Google Cloud Console → Credentials → Regenerate)
#   - VITE_GEMINI_API_KEY      (AI Studio → API Keys → Create new)
#   - VITE_SENTRY_DSN          (Sentry → Project Settings → Client Keys → Rotate)
# Do NOT reuse the old values. Rotate them in all deployment environments.

# SUPABASE (Required)
# Get from: https://supabase.com/dashboard → Project Settings → API
VITE_SUPABASE_URL=YOUR_SUPABASE_URL_HERE
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE

# RESEND (Required for email sending)
# Get from: https://resend.com/api-keys
RESEND_API_KEY=YOUR_RESEND_API_KEY_HERE

# GOOGLE MAPS (Optional - for interactive maps)
# Get from: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# GEMINI API (Optional - for Website Analyzer AI)
# Get from: https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# PERPLEXITY API (Optional - for enhanced AI search)
# Get from: https://www.perplexity.ai/settings/api
VITE_PERPLEXITY_API_KEY=YOUR_PERPLEXITY_API_KEY_HERE

# SENTRY (Error Monitoring - Optional)
# Get from: https://sentry.io/settings/projects/ -> Client Keys (DSN)
VITE_SENTRY_DSN=YOUR_SENTRY_DSN_HERE
VITE_GA_MEASUREMENT_ID=YOUR_GA_MEASUREMENT_ID_HERE
